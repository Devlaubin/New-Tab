{
  "manifest_version": 3,
  "name": "New-Tab Search Tracker",
  "version": "1.0",
  "description": "Compter les recherches même quand la page New-Tab n'est pas ouverte.",
  "permissions": ["tabs", "storage"],
  "host_permissions": [
    "*://*.google.com/*",
    "*://*.bing.com/*",
    "*://*.duckduckgo.com/*",
    "*://search.brave.com/*",
    "*://*.qwant.com/*",
    "*://*.startpage.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "New-Tab Search Tracker"
  }
}
